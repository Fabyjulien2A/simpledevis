use App\Models\ElectronicInvoice;
use Illuminate\Support\Facades\Cache;


/*
|--------------------------------------------------------------------------
| Routes de test IOPOLE
|--------------------------------------------------------------------------
|
| Routes temporaires utilisées pour tester
| la connexion à l’API IOPOLE.
|
| ⚠️ À supprimer en production.
|
*/

Route::prefix('test-iopole')->group(function () {

    /*
    |--------------------------------------------------------------------------
    | Test token IOPOLE
    |--------------------------------------------------------------------------
    */
    Route::get('/token', function (IopoleService $iopole) {

        Cache::forget('iopole_access_token');

        $token = $iopole->getAccessToken();

        dd(substr($token, 0, 80) . '...');
    });

    /*
    |--------------------------------------------------------------------------
    | Liste des webhooks
    |--------------------------------------------------------------------------
    */
    Route::get('/webhooks', function (IopoleService $iopole) {

        $response = $iopole->client()->get('/v1/config/webhook');

        dd($response->status(), $response->json() ?? $response->body());
    });

    Route::get('/test-iopole/status-debug/{invoiceId}', function (IopoleService $iopole, string $invoiceId) {
    $statuses = $iopole->getInvoiceStatus($invoiceId);

    return response()->json($statuses, 200, [], JSON_PRETTY_PRINT);
});

    /*
    |--------------------------------------------------------------------------
    | Factures non vues
    |--------------------------------------------------------------------------
    */
    Route::get('/not-seen', function (IopoleService $iopole) {

        return response()->json(
            $iopole->getNotSeenInvoices()
        );
    });

    /*
    |--------------------------------------------------------------------------
    | Envoi facture test
    |--------------------------------------------------------------------------
    */
    Route::get('/send-invoice', function (IopoleService $iopole) {

        $filePath = storage_path('app/test-facture.pdf');

        $response = $iopole->sendInvoiceFile($filePath);

        $electronicInvoice = ElectronicInvoice::create([
            'invoice_id' => 1, // temporaire
            'iopole_invoice_id' => $response['id'] ?? null,
            'status' => 'submitted',
            'response_payload' => $response,
            'sent_at' => now(),
        ]);

        return response()->json([
            'message' => 'Facture envoyée avec succès',
            'invoice' => $electronicInvoice,
            'iopole_response' => $response,
        ]);
    });

    /*
    |--------------------------------------------------------------------------
    | Historique des statuts facture
    |--------------------------------------------------------------------------
    */
    Route::get('/status/{invoiceId}', function (
        IopoleService $iopole,
        string $invoiceId
    ) {

        $statuses = $iopole->getInvoiceStatus($invoiceId);

        return response()->json([
            'count' => count($statuses),
            'statuses' => collect($statuses)->map(function ($status) {
                return [
                    'invoice_id' => $status['invoiceId'] ?? null,
                    'status_id' => $status['statusId'] ?? null,
                    'date' => $status['date'] ?? null,
                    'code' => $status['status']['code'] ?? null,
                    'value' => $status['status']['value'] ?? null,
                    'description' => $status['status']['desc'] ?? null,
                    'document_status' => $status['json']['responses'][0]['documentStatus']['status']['code'] ?? null,
                    'document_description' => $status['json']['responses'][0]['documentStatus']['status']['desc'] ?? null,
                ];
            }),
        ]);
    });
});

